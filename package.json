{
  "name": "six-degrees",
  "version": "0.2.1",
  "description": "Map your professional network as a galaxy — leverage tiers, bridges into new circles, and the shortest path to anyone. Runs locally on your own data.",
  "license": "MIT",
  "author": "Blake Burford",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blakeb056/six-degrees.git"
  },
  "bugs": {
    "url": "https://github.com/blakeb056/six-degrees/issues"
  },
  "homepage": "https://blakeb056.github.io/six-degrees/",
  "keywords": [
    "linkedin",
    "network",
    "graph",
    "visualization",
    "d3",
    "local-first",
    "networking",
    "career"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "private": false,
  "bin": {
    "six-degrees": "bin/six-degrees.mjs"
  },
  "files": [
    "bin/",
    ".next/standalone/",
    ".next/static/",
    "public/",
    "db/",
    "lib/",
    "scripts/scrape.py",
    "scripts/image_store.py",
    "scripts/requirements.txt",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "scripts/check-node.mjs",
    "scripts/audit-avatars.mjs",
    "scripts/check-stale-server.mjs",
    "scripts/update.mjs"
  ],
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 SIX_DEGREES_BIND=127.0.0.1 next dev -H 127.0.0.1",
    "predev": "node scripts/check-node.mjs && node scripts/check-stale-server.mjs",
    "fresh": "node scripts/check-node.mjs && node scripts/sandbox.mjs",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build && node scripts/prepare-standalone.mjs",
    "prebuild": "node scripts/check-node.mjs",
    "start": "NEXT_TELEMETRY_DISABLED=1 SIX_DEGREES_BIND=127.0.0.1 next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "gen:demo": "node scripts/gen-synthetic.mjs",
    "prepack": "npm run build",
    "start:packaged": "node bin/six-degrees.mjs",
    "scrape": "python3 scripts/scrape.py",
    "scrape:login": "python3 scripts/scrape.py --login",
    "scrape:server": "python3 scripts/scrape.py --server",
    "setup:python": "python3 -m pip install -r scripts/requirements.txt",
    "scrape:full": "python3 scripts/scrape.py --full",
    "scrape:refresh": "python3 scripts/scrape.py --refresh",
    "audit:avatars": "node scripts/audit-avatars.mjs",
    "build:app": "node scripts/build-app.mjs",
    "build:desktop": "node scripts/build-app.mjs --shell=electron",
    "desktop": "electron desktop",
    "update": "node scripts/update.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "d3": "^7.9.0",
    "electron": "44.4.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "next": "16.3.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
