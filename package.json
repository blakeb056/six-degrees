{
  "name": "six-degrees",
  "version": "0.1.0",
  "description": "Map your professional network as a galaxy \u2014 leverage tiers, bridges into new circles, and the shortest path to anyone. Runs locally on your own data.",
  "license": "MIT",
  "author": "Blake Burford",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blakeb056/six-degrees-app.git"
  },
  "bugs": {
    "url": "https://github.com/blakeb056/six-degrees-app/issues"
  },
  "homepage": "https://github.com/blakeb056/six-degrees-app#readme",
  "keywords": [
    "linkedin",
    "network",
    "graph",
    "visualization",
    "d3",
    "local-first",
    "networking",
    "career"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "private": false,
  "bin": {
    "six-degrees": "bin/six-degrees.mjs"
  },
  "files": [
    "bin/",
    ".next/standalone/",
    ".next/static/",
    "public/",
    "db/",
    "lib/",
    "scripts/scrape.py",
    "scripts/image_store.py",
    "scripts/requirements.txt",
    "scripts/score_new_connections.sql",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 SIX_DEGREES_BIND=127.0.0.1 next dev -H 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build && node scripts/prepare-standalone.mjs",
    "start": "NEXT_TELEMETRY_DISABLED=1 SIX_DEGREES_BIND=127.0.0.1 next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "gen:demo": "node scripts/gen-synthetic.mjs",
    "prepack": "npm run build",
    "start:packaged": "node bin/six-degrees.mjs",
    "scrape": "python3 scripts/scrape.py",
    "scrape:server": "python3 scripts/scrape.py --server",
    "setup:python": "python3 -m pip install -r scripts/requirements.txt"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.2.9"
  }
}
