<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Six Degrees.app and its Electron helper apps (GPU, Renderer, Plugin), signed
  with Developer ID and the hardened runtime (scripts/mac-sign.mjs, DESKTOP.md D4).

  allow-jit                          V8 compiles JavaScript as it runs; the hardened
                                     runtime refuses that without it.
  allow-unsigned-executable-memory   what V8 still uses where it can't use MAP_JIT
                                     (Intel Macs). Discord's and Electron's own
                                     templates carry the same two.

  Never disable-library-validation: every library the app loads is signed by the
  same team in the same pass, and it loads nothing from outside itself.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
