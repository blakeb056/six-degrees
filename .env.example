# 6 Degrees runs entirely on your machine. There is nothing you must configure
# — these are all optional.

# Where your data lives: the SQLite database and captured avatars.
# Defaults to ~/.six-degrees
# SIX_DEGREES_HOME=/path/to/your/data

# Only needed if you expose this app beyond your own machine — through a
# tunnel, a LAN address, or a deployment. On localhost the four destructive
# routes (admin-delete, admin-update, delete-cluster, setup-profile) are
# allowed, because anyone who can reach 127.0.0.1 can already open the database
# file directly. From any other host they require this as a bearer token, and
# refuse to run if it is unset.
# Generate with: openssl rand -hex 32
# ADMIN_TOKEN=

# Where the scraper pushes what it captures. Defaults to the app on this
# machine. Pointing it anywhere else would send your network to a server you
# do not control, so a remote host additionally requires ALLOW_REMOTE_PUSH=1.
# APP_URL=http://localhost:3000
