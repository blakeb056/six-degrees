# Client-side (public — read-only via RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side ONLY (secret — full write access, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# For the Python scraper (same service_role key)
# export SUPABASE_SERVICE_KEY=your-service-role-key-here

# Token for the destructive API routes (admin-delete, admin-update,
# delete-cluster, setup-profile). Everything else in the deployed app is public.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Set to true to build the public, backend-free static demo instead
# NEXT_PUBLIC_DEMO_MODE=true
